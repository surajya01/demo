{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@packages/*": ["./packages/*"],
      "@apexify/database": ["./packages/database/src"],
      "@apexify/shared-types": ["./packages/shared-types/src"],
      "@apexify/validation": ["./packages/validation/src"],
      "@apexify/ui": ["./packages/ui/src"],
      "@dhuri/database": ["./packages/database/src"],
      "@dhuri/shared-types": ["./packages/shared-types/src"],
      "@dhuri/validation": ["./packages/validation/src"],
      "@dhuri/ui": ["./packages/ui/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
