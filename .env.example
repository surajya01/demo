# ==============================================================================
# Dhuri Resort Digital Hospitality Platform - Environment Configuration
# Developed by Apexify
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL 8.0+)
# ------------------------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@localhost:3306/dhuri_resort"

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Dhuri Resort"
NEXT_PUBLIC_DEVELOPER_CREDIT="Designed & Developed by Apexify"

# ------------------------------------------------------------------------------
# 3. RESORT IDENTITY & CONTACT DEFAULTS (Pre-verification placeholders)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RESORT_PHONE="+91 00000 00000"
NEXT_PUBLIC_RESORT_EMAIL="info@dhuri-resort.example.com"
NEXT_PUBLIC_RESORT_ADDRESS="Near Navjeevan Naka, Waliv, Vasai Road - East, Vasai 401208, Maharashtra, India"

# ------------------------------------------------------------------------------
# 4. RESERVATION & QR SETTINGS
# ------------------------------------------------------------------------------
BOOKING_HOLD_EXPIRY_MINUTES=15
DEFAULT_CURRENCY="INR"
RESORT_TIMEZONE="Asia/Kolkata"

# ------------------------------------------------------------------------------
# 5. FUTURE MODULE PLACEHOLDERS (DO NOT ACTIVATE IN PHASE 1)
# ------------------------------------------------------------------------------
# Authentication, Payment Gateway and Notification secrets will be configured
# in their respective future phases.
# NEXTAUTH_SECRET=""
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# WHATSAPP_API_TOKEN=""
