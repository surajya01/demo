// ==============================================================================
// Apexify Resort Digital Hospitality Platform - Database Schema
// Developed by Apexify
// Database: MySQL 8.0+
// ORM: Prisma ORM
// Note: Authentication is explicitly NOT included in Phase 1 per design directive.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  REFUND_PENDING
  REFUNDED
  NO_SHOW
  EXPIRED
}

enum BookingSource {
  WEBSITE
  WHATSAPP
  PHONE
  WALK_IN
  ADMIN
}

enum RoomOperationalStatus {
  ACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum EnquiryStatus {
  PENDING
  CONTACTED
  CONVERTED
  CLOSED
  CANCELLED
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

enum RestaurantOrderStatus {
  PLACED
  ACCEPTED
  REJECTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  ROOM_SERVICE
  TAKEAWAY
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE
}

enum TableSessionStatus {
  OPEN
  BILLED
  CLOSED
  CANCELLED
}

enum DietaryType {
  VEGETARIAN
  NON_VEGETARIAN
  EGG
  VEGAN
  JAIN
}

enum QRTargetType {
  TABLE
  ROOM
}

enum QRStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum ServiceRequestStatus {
  SUBMITTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum ServicePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  ONLINE_UPI
  ONLINE_CARD
  ONLINE_NETBANKING
  CASH
  CARD_SWIPE
  PAY_AT_PROPERTY
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FLAT_AMOUNT
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// ------------------------------------------------------------------------------
// 1. ROOM CATALOGUE & INVENTORY
// ------------------------------------------------------------------------------

model RoomType {
  id               String   @id @default(uuid()) @db.VarChar(36)
  name             String   @db.VarChar(100)
  slug             String   @unique @db.VarChar(100)
  description      String?  @db.Text
  shortDescription String?  @db.VarChar(255)
  maxAdults        Int      @default(2)
  maxChildren      Int      @default(1)
  maxOccupancy     Int      @default(3)
  basePrice        Decimal  @db.Decimal(12, 2)
  sizeSqFt         Int?
  bedConfiguration String?  @db.VarChar(100)
  amenities        Json?
  isPublished      Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rooms        Room[]
  images       RoomImage[]
  rates        RoomRate[]
  inventory    RoomInventory[]
  bookingRooms BookingRoom[]
  bookingHolds BookingHold[]
  enquiries    BookingEnquiry[]

  @@index([isPublished, sortOrder])
  @@map("room_types")
}

model Room {
  id                String                @id @default(uuid()) @db.VarChar(36)
  roomTypeId        String                @db.VarChar(36)
  roomNumber        String                @unique @db.VarChar(20)
  floorLabel        String?               @db.VarChar(50)
  operationalStatus RoomOperationalStatus @default(ACTIVE)
  isBookable        Boolean               @default(true)
  notes             String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  roomType        RoomType             @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  bookingRooms    BookingRoom[]
  qrAssignments   QRAssignment[]
  serviceRequests RoomServiceRequest[]
  orders          Order[]

  @@index([roomTypeId, operationalStatus])
  @@map("rooms")
}

model RoomImage {
  id         String   @id @default(uuid()) @db.VarChar(36)
  roomTypeId String   @db.VarChar(36)
  storagePath String  @db.VarChar(255)
  altText    String?  @db.VarChar(255)
  isCover    Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, sortOrder])
  @@map("room_images")
}

model RatePlan {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  name               String   @db.VarChar(100)
  code               String   @unique @db.VarChar(50)
  description        String?  @db.Text
  mealPlan           String?  @db.VarChar(50)
  cancellationPolicy String?  @db.Text
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  roomRates    RoomRate[]
  bookingRooms BookingRoom[]

  @@map("rate_plans")
}

model RoomRate {
  id         String   @id @default(uuid()) @db.VarChar(36)
  roomTypeId String   @db.VarChar(36)
  ratePlanId String   @db.VarChar(36)
  validFrom  DateTime @db.Date
  validTo    DateTime @db.Date
  dayOfWeek  Int?
  baseAmount Decimal  @db.Decimal(12, 2)
  currency   String   @default("INR") @db.VarChar(3)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Restrict)

  @@index([roomTypeId, validFrom, validTo, isActive])
  @@index([ratePlanId])
  @@map("room_rates")
}

model RoomInventory {
  id           String   @id @default(uuid()) @db.VarChar(36)
  roomTypeId   String   @db.VarChar(36)
  stayDate     DateTime @db.Date
  totalUnits   Int
  bookedUnits  Int      @default(0)
  blockedUnits Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, stayDate])
  @@index([stayDate, roomTypeId])
  @@map("room_inventory")
}

// ------------------------------------------------------------------------------
// 2. GUESTS & RESERVATIONS
// ------------------------------------------------------------------------------

model Guest {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  fullName           String   @db.VarChar(150)
  phone              String   @db.VarChar(30)
  email              String?  @db.VarChar(150)
  address            String?  @db.Text
  city               String?  @db.VarChar(100)
  state              String?  @db.VarChar(100)
  pincode            String?  @db.VarChar(20)
  country            String   @default("India") @db.VarChar(100)
  idType             String?  @db.VarChar(50)
  idNumberEncrypted  String?  @db.VarChar(255)
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bookings     Booking[]
  bookingHolds BookingHold[]

  @@index([phone])
  @@index([email])
  @@map("guests")
}

model Booking {
  id                 String        @id @default(uuid()) @db.VarChar(36)
  bookingReference   String        @unique @db.VarChar(30)
  leadGuestId        String        @db.VarChar(36)
  checkIn            DateTime      @db.Date
  checkOut           DateTime      @db.Date
  adults             Int           @default(1)
  children           Int           @default(0)
  status             BookingStatus @default(PENDING)
  source             BookingSource @default(WEBSITE)
  subtotal           Decimal       @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  currency           String        @default("INR") @db.VarChar(3)
  priceSnapshot      Json
  policySnapshot     Json
  specialRequests    String?       @db.Text
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  cancelledAt        DateTime?
  cancellationReason String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  leadGuest       Guest                @relation(fields: [leadGuestId], references: [id], onDelete: Restrict)
  bookingRooms    BookingRoom[]
  payments        Payment[]
  serviceRequests RoomServiceRequest[]
  orders          Order[]

  @@index([status, checkIn, checkOut])
  @@index([bookingReference])
  @@index([leadGuestId])
  @@map("bookings")
}

model BookingRoom {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  bookingId           String   @db.VarChar(36)
  roomTypeId          String   @db.VarChar(36)
  roomId              String?  @db.VarChar(36)
  ratePlanId          String?  @db.VarChar(36)
  quantity            Int      @default(1)
  nightlyRateSnapshot Json
  occupancySnapshot   Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room     Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  ratePlan RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([roomTypeId])
  @@index([roomId])
  @@map("booking_rooms")
}

model BookingEnquiry {
  id                  String        @id @default(uuid()) @db.VarChar(36)
  guestName           String        @db.VarChar(150)
  phone               String        @db.VarChar(30)
  email               String?       @db.VarChar(150)
  checkIn             DateTime?     @db.Date
  checkOut            DateTime?     @db.Date
  adults              Int?          @default(1)
  children            Int?          @default(0)
  preferredRoomTypeId String?       @db.VarChar(36)
  message             String?       @db.Text
  status              EnquiryStatus @default(PENDING)
  adminNotes          String?       @db.Text
  convertedBookingId  String?       @db.VarChar(36)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  preferredRoomType RoomType? @relation(fields: [preferredRoomTypeId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([phone])
  @@map("booking_enquiries")
}

model BookingHold {
  id            String     @id @default(uuid()) @db.VarChar(36)
  holdTokenHash String     @unique @db.VarChar(64)
  roomTypeId    String     @db.VarChar(36)
  guestId       String?    @db.VarChar(36)
  checkIn       DateTime   @db.Date
  checkOut      DateTime   @db.Date
  quantity      Int        @default(1)
  status        HoldStatus @default(ACTIVE)
  expiresAt     DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  guest    Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([expiresAt, status])
  @@index([holdTokenHash])
  @@map("booking_holds")
}

// ------------------------------------------------------------------------------
// 3. RESTAURANT & ORDERING
// ------------------------------------------------------------------------------

model Restaurant {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  openingTime String?  @db.VarChar(10)
  closingTime String?  @db.VarChar(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuCategories MenuCategory[]
  tables         RestaurantTable[]

  @@map("restaurants")
}

model MenuCategory {
  id           String   @id @default(uuid()) @db.VarChar(36)
  restaurantId String   @db.VarChar(36)
  name         String   @db.VarChar(100)
  slug         String   @db.VarChar(100)
  description  String?  @db.Text
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id                 String      @id @default(uuid()) @db.VarChar(36)
  categoryId         String      @db.VarChar(36)
  name               String      @db.VarChar(150)
  description        String?     @db.Text
  imagePath          String?     @db.VarChar(255)
  price              Decimal     @db.Decimal(12, 2)
  currency           String      @default("INR") @db.VarChar(3)
  dietaryType        DietaryType @default(VEGETARIAN)
  isAvailable        Boolean     @default(true)
  preparationMinutes Int?        @default(20)
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  category   MenuCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants   MenuItemVariant[]
  orderItems OrderItem[]

  @@index([categoryId, isAvailable])
  @@map("menu_items")
}

model MenuItemVariant {
  id         String   @id @default(uuid()) @db.VarChar(36)
  menuItemId String   @db.VarChar(36)
  name       String   @db.VarChar(100)
  priceDelta Decimal  @default(0.00) @db.Decimal(12, 2)
  isAvailable Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_variants")
}

model RestaurantTable {
  id           String      @id @default(uuid()) @db.VarChar(36)
  restaurantId String      @db.VarChar(36)
  tableNumber  String      @db.VarChar(20)
  sectionLabel String?     @db.VarChar(50)
  capacity     Int         @default(4)
  status       TableStatus @default(AVAILABLE)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableSessions TableSession[]
  qrAssignments QRAssignment[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId, status])
  @@map("restaurant_tables")
}

model TableSession {
  id              String             @id @default(uuid()) @db.VarChar(36)
  tableId         String             @db.VarChar(36)
  qrAssignmentId  String?            @db.VarChar(36)
  guestIdentifier String?            @db.VarChar(100)
  openedAt        DateTime           @default(now())
  closedAt        DateTime?
  status          TableSessionStatus @default(OPEN)
  notes           String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  qrAssignment QRAssignment?   @relation(fields: [qrAssignmentId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([tableId, status])
  @@index([openedAt])
  @@map("table_sessions")
}

model Order {
  id                  String                @id @default(uuid()) @db.VarChar(36)
  orderNumber         String                @unique @db.VarChar(30)
  tableSessionId      String?               @db.VarChar(36)
  bookingId           String?               @db.VarChar(36)
  roomId              String?               @db.VarChar(36)
  orderType           OrderType             @default(DINE_IN)
  status              RestaurantOrderStatus @default(PLACED)
  subtotal            Decimal               @db.Decimal(12, 2)
  taxAmount           Decimal               @default(0.00) @db.Decimal(12, 2)
  totalAmount         Decimal               @db.Decimal(12, 2)
  specialInstructions String?               @db.Text
  estimatedReadyAt    DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tableSession TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  room         Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  orderItems   OrderItem[]
  payments     Payment[]

  @@index([status, createdAt])
  @@index([orderNumber])
  @@index([tableSessionId])
  @@index([roomId])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  orderId            String   @db.VarChar(36)
  menuItemId         String?  @db.VarChar(36)
  itemNameSnapshot   String   @db.VarChar(150)
  unitPriceSnapshot  Decimal  @db.Decimal(12, 2)
  quantity           Int      @default(1)
  variantSnapshot    Json?
  lineTotal          Decimal  @db.Decimal(12, 2)
  notes              String?  @db.VarChar(255)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ------------------------------------------------------------------------------
// 4. QR ASSIGNMENTS & ROOM SERVICE
// ------------------------------------------------------------------------------

model QRAssignment {
  id            String       @id @default(uuid()) @db.VarChar(36)
  tokenHash     String       @unique @db.VarChar(64)
  targetType    QRTargetType
  tableId       String?      @db.VarChar(36)
  roomId        String?      @db.VarChar(36)
  status        QRStatus     @default(ACTIVE)
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?      @db.VarChar(255)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: Cascade)
  room          Room?            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tableSessions TableSession[]

  @@index([tokenHash])
  @@index([targetType, status])
  @@map("qr_assignments")
}

model ServiceType {
  id              String          @id @default(uuid()) @db.VarChar(36)
  name            String          @db.VarChar(100)
  code            String          @unique @db.VarChar(50)
  description     String?         @db.Text
  defaultPriority ServicePriority @default(NORMAL)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  serviceRequests RoomServiceRequest[]

  @@map("service_types")
}

model RoomServiceRequest {
  id                 String               @id @default(uuid()) @db.VarChar(36)
  roomId             String               @db.VarChar(36)
  bookingId          String?              @db.VarChar(36)
  serviceTypeId      String               @db.VarChar(36)
  description        String?              @db.Text
  status             ServiceRequestStatus @default(SUBMITTED)
  priority           ServicePriority      @default(NORMAL)
  assignedStaffNotes String?              @db.Text
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  room        Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  booking     Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([roomId])
  @@map("room_service_requests")
}

// ------------------------------------------------------------------------------
// 5. PAYMENTS & REFUNDS
// ------------------------------------------------------------------------------

model Payment {
  id                 String        @id @default(uuid()) @db.VarChar(36)
  bookingId          String?       @db.VarChar(36)
  orderId            String?       @db.VarChar(36)
  provider           String        @default("RAZORPAY") @db.VarChar(50)
  providerOrderId    String?       @db.VarChar(100)
  providerPaymentId  String?       @db.VarChar(100)
  providerSignature  String?       @db.VarChar(255)
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("INR") @db.VarChar(3)
  method             PaymentMethod @default(ONLINE_UPI)
  status             PaymentStatus @default(CREATED)
  idempotencyKey     String        @unique @db.VarChar(100)
  verifiedAt         DateTime?
  rawResponse        Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  refunds Refund[]

  @@index([status, createdAt])
  @@index([providerPaymentId])
  @@index([bookingId])
  @@index([orderId])
  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid()) @db.VarChar(36)
  paymentId        String       @db.VarChar(36)
  providerRefundId String?      @db.VarChar(100)
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("INR") @db.VarChar(3)
  status           RefundStatus @default(PENDING)
  reason           String?      @db.Text
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

// ------------------------------------------------------------------------------
// 6. WEBSITE CONTENT & CMS
// ------------------------------------------------------------------------------

model WebsitePage {
  id              String   @id @default(uuid()) @db.VarChar(36)
  slug            String   @unique @db.VarChar(100)
  title           String   @db.VarChar(200)
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  content         Json?
  isPublished     Boolean  @default(true)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sections WebsiteSection[]

  @@index([slug, isPublished])
  @@map("website_pages")
}

model WebsiteSection {
  id         String   @id @default(uuid()) @db.VarChar(36)
  pageId     String   @db.VarChar(36)
  sectionKey String   @db.VarChar(100)
  title      String?  @db.VarChar(200)
  subtitle   String?  @db.VarChar(255)
  content    Json?
  sortOrder  Int      @default(0)
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  page WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, sectionKey])
  @@index([pageId, sortOrder])
  @@map("website_sections")
}

model MediaAsset {
  id            String   @id @default(uuid()) @db.VarChar(36)
  title         String?  @db.VarChar(200)
  storagePath   String   @db.VarChar(255)
  fileType      String   @db.VarChar(50)
  fileSizeBytes Int?
  altText       String?  @db.VarChar(255)
  category      String   @default("GENERAL") @db.VarChar(50)
  isVerified    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([storagePath])
  @@map("media_assets")
}

model Offer {
  id               String       @id @default(uuid()) @db.VarChar(36)
  title            String       @db.VarChar(200)
  code             String?      @unique @db.VarChar(50)
  description      String?      @db.Text
  discountType     DiscountType @default(PERCENTAGE)
  discountValue    Decimal      @db.Decimal(12, 2)
  minBookingAmount Decimal?     @db.Decimal(12, 2)
  validFrom        DateTime
  validTo          DateTime
  isActive         Boolean      @default(true)
  bannerImagePath  String?      @db.VarChar(255)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([validFrom, validTo, isActive])
  @@index([code])
  @@map("offers")
}

// ------------------------------------------------------------------------------
// 7. NOTIFICATIONS & AUDIT LOGS
// ------------------------------------------------------------------------------

model Notification {
  id            String              @id @default(uuid()) @db.VarChar(36)
  channel       NotificationChannel @default(EMAIL)
  recipient     String              @db.VarChar(150)
  subject       String?             @db.VarChar(255)
  content       String              @db.Text
  status        NotificationStatus  @default(PENDING)
  referenceType String?             @db.VarChar(50)
  referenceId   String?             @db.VarChar(36)
  attemptCount  Int                 @default(0)
  lastError     String?             @db.Text
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, channel])
  @@index([referenceType, referenceId])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  actorId    String?  @db.VarChar(36)
  actorType  String   @default("SYSTEM") @db.VarChar(50)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(36)
  metadata   Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
